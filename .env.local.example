# ===========================================
# COMPAROS - AI-Powered Product Comparison
# ===========================================

# WEB SEARCH API (Choose one - all free tiers available)
# Get free API key at: https://brave.com/search/api/
BRAVE_API_KEY=your_brave_search_api_key_here

# Alternative: SerpAPI (2,500 free searches/month)
# Get at: https://serpapi.com/
# SERP_API_KEY=your_serpapi_key_here

# Alternative: Google Custom Search (100 free searches/day)
# Get at: https://developers.google.com/custom-search
# GOOGLE_SEARCH_API_KEY=your_google_key_here
# GOOGLE_SEARCH_ENGINE_ID=your_engine_id_here

# AI API (For intelligent parsing - Choose one)
# OpenAI GPT-4 (Best for product data extraction)
# Get at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Alternative: Anthropic Claude (Also excellent)
# Get at: https://console.anthropic.com/
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# IMAGE SEARCH (Optional - for real product images)
# Bing Image Search API
# Get at: https://www.microsoft.com/en-us/bing/apis/bing-image-search-api
# BING_IMAGE_SEARCH_KEY=your_bing_key_here

# WEB SCRAPING (REQUIRED - for bypassing anti-bot measures)
# ScraperAPI (1,000 free requests/month, then ~$50/month)
# Get at: https://www.scraperapi.com/
# This is REQUIRED for scraping Amazon, Best Buy, etc.
SCRAPER_API_KEY=your_scraper_api_key_here

# ===========================================
# QUICK SETUP (Recommended)
# ===========================================
# 1. Get Brave Search API (FREE 2,000 queries/month):
#    https://brave.com/search/api/
#
# 2. Get OpenAI API key (Pay-as-you-go):
#    https://platform.openai.com/api-keys
#
# 3. Get ScraperAPI key (1,000 FREE requests/month):
#    https://www.scraperapi.com/
#    Required for scraping Amazon, Best Buy, etc.
#
# 4. Copy this file to .env.local and add your keys
# 5. Restart your dev server
#
# That's it! Comparos will now search the real web!
# ===========================================
